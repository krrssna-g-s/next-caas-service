# Example global.properties for ONE environment (this one: canary).
# Not part of the image: in EKS it is served by the properties service and read
# from PROPS_PATH; locally it is ./global.properties. Each environment (alpha,
# beta1, beta2, canary, stage, prod) gets its own file with its own values.
#
# Read with properties-reader: key=value, # comments, [section] headers.
# Plain keys apply to both zones; [east] / [west] hold what differs by zone.
# A [section] lasts until the next one, so keep shared keys at the top.
# Precedence: environment variable (pod spec / ConfigMap / Secret) > [zone] > top of file.
# Keys may be env-var names (CAAS_CDN_MAX_AGE) or dotted (caas.cdn.max-age).
# ${NAME} is replaced with another value from the environment or this file.

# Optional: name the environment here instead of in the Kubernetes overlay.
# caas.env=canary

# ---------- content service ----------
caas.replication.group=prod
caas.seed.version=1
caas.history.limit=20
caas.max.body.bytes=1048576
caas.html.policy=sanitize

# ---------- caching / CDN ----------
caas.browser.max.age=60
caas.cdn.max.age=86400
caas.not.found.cdn.max.age=30
akamai.network=production
akamai.purge.mode=invalidate

# ---------- replication ----------
caas.sync.interval.ms=15000
caas.push.timeout.ms=3000
# Pods in this cluster: headless Service DNS names (same in both zones' clusters).
caas.peer.dns=caas-headless.caas-prod.svc.cluster.local,caas-headless.caas-canary.svc.cluster.local

# ---------- monitoring ----------
new.relic.enabled=true
new.relic.app.name=caas-service-canary
# Secrets are better in the Kubernetes Secret; if referenced here, point at an env var:
# new.relic.license.key=${NR_LICENSE_KEY}

# ---------- per zone ----------
[east]
# The other zone's internal sync endpoint.
caas.remote.peers=https://caas-sync.prod.west.internal.example.com

[west]
caas.remote.peers=https://caas-sync.prod.east.internal.example.com
