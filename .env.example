# Copy to .env.local for local development. In EKS these come from the ConfigMap and Secret.

# --- identity (the only values that differ per environment and zone) ---
CAAS_ENV=local                 # sit | canary | stage | prod
CAAS_ZONE=local                # east | west
# CAAS_REPLICATION_GROUP=prod  # defaults to CAAS_ENV; canary sets "prod" to share prod content
# POD_NAME=                    # set by Kubernetes; must be unique per pod

# --- secrets ---
CAAS_ADMIN_TOKENS=me:change-me-to-a-long-random-token      # name:token[,name:token]
CAAS_SYNC_SECRET=change-me-to-a-long-random-secret         # same value on every pod of a group

# --- embedded database ---
CAAS_DATA_DIR=./.caas-data
CAAS_SEED_DIR=./content-seed
CAAS_SEED_VERSION=1            # raise when a release ships newer seed content
CAAS_HISTORY_LIMIT=20
CAAS_MAX_BODY_BYTES=1048576
CAAS_HTML_POLICY=sanitize     # sanitize: strip unsafe HTML from string values | reject: refuse the write

# --- replication ---
# CAAS_PEER_DNS=caas-headless.caas-prod.svc.cluster.local   # pods of this cluster (headless service)
# CAAS_PEER_PORT=3000
# CAAS_PEERS=http://127.0.0.1:3001,http://127.0.0.1:3002      # static list, for local runs
# CAAS_REMOTE_PEERS=https://caas-sync.prod.west.internal.example.com   # the other zone
CAAS_SYNC_INTERVAL_MS=15000
CAAS_PUSH_TIMEOUT_MS=3000
CAAS_BOOTSTRAP_TIMEOUT_MS=30000

# --- caching ---
CAAS_BROWSER_MAX_AGE=60
CAAS_CDN_MAX_AGE=86400
CAAS_NOT_FOUND_CDN_MAX_AGE=30
CAAS_STALE_WHILE_REVALIDATE=30
CAAS_MEMORY_CACHE_ENTRIES=5000
# CAAS_CORS_ALLOW_ORIGIN=*

# --- Akamai Fast Purge (EdgeGrid API client with CCU purge permission) ---
# AKAMAI_HOST=akab-xxxxxxxx.luna.akamaiapis.net
# AKAMAI_CLIENT_TOKEN=
# AKAMAI_CLIENT_SECRET=
# AKAMAI_ACCESS_TOKEN=
# AKAMAI_NETWORK=production     # or staging
# AKAMAI_PURGE_MODE=invalidate  # or delete

# --- global.properties (see README) ---
# PROPS_PATH=http://props-service.props.svc.cluster.local/caas/sit/global.properties   # unset locally: ./global.properties
# PROPS_AUTH=Bearer ...
# PROPS_FETCH_TIMEOUT_MS=30000

# --- New Relic (off without a license key) ---
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_APP_NAME=caas-service-local
# NEW_RELIC_ENABLED=true
